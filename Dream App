<script>
    // ============================================================
    // AUTH SYSTEM
    // ============================================================
    let currentUser = null;
    let users = JSON.parse(localStorage.getItem('dream_users')) || {};
    let isLogin = false;

    function updateAuthUI() {
        const btn = document.getElementById('authSubmitBtn');
        const toggle = document.getElementById('authToggle');
        if (isLogin) {
            btn.textContent = 'Sign In';
            toggle.textContent = 'Sign Up';
        } else {
            btn.textContent = 'Sign Up';
            toggle.textContent = 'Sign In';
        }
    }

    document.getElementById('authToggle').addEventListener('click', () => {
        isLogin = !isLogin;
        updateAuthUI();
    });

    document.getElementById('authSubmitBtn').addEventListener('click', () => {
        const name = document.getElementById('authName').value.trim();
        const email = document.getElementById('authEmail').value.trim();
        const password = document.getElementById('authPassword').value.trim();

        if (!email || !password || (!isLogin && !name)) {
            showToast('❌ Please fill all fields');
            return;
        }

        if (isLogin) {
            // Login
            if (users[email] && users[email].password === password) {
                currentUser = users[email];
                currentUser.email = email;
                loginSuccess();
            } else {
                showToast('❌ Invalid email or password');
            }
        } else {
            // Register
            if (users[email]) {
                showToast('❌ Email already registered');
                return;
            }
            users[email] = { name, password, phone: '9001560080', dp: '', contacts: [], groups: [], messages: {} };
            localStorage.setItem('dream_users', JSON.stringify(users));
            currentUser = users[email];
            currentUser.email = email;
            showToast('✅ Account created!');
            loginSuccess();
        }
    });

    function loginSuccess() {
        document.getElementById('authScreen').style.display = 'none';
        document.getElementById('mainApp').style.display = 'flex';
        document.getElementById('settingsUserName').textContent = currentUser.name;
        document.getElementById('settingsUserPhone').textContent = `📱 +91 ${currentUser.phone}`;
        document.getElementById('profilePic').textContent = currentUser.name[0].toUpperCase();
        if (currentUser.dp) {
            document.getElementById('profilePic').innerHTML = `<img src="${currentUser.dp}" alt="DP">`;
        }
        // Load user data
        if (!currentUser.contacts) currentUser.contacts = [];
        if (!currentUser.groups) currentUser.groups = [];
        if (!currentUser.messages) currentUser.messages = {};
        renderChatList();
        updateStatusTime();
        setInterval(updateStatusTime, 10000);
    }

    // Check if already logged in
    (function checkAutoLogin() {
        const saved = localStorage.getItem('dream_last_user');
        if (saved && users[saved]) {
            currentUser = users[saved];
            currentUser.email = saved;
            document.getElementById('authScreen').style.display = 'none';
            document.getElementById('mainApp').style.display = 'flex';
            document.getElementById('settingsUserName').textContent = currentUser.name;
            document.getElementById('settingsUserPhone').textContent = `📱 +91 ${currentUser.phone}`;
            document.getElementById('profilePic').textContent = currentUser.name[0].toUpperCase();
            if (currentUser.dp) {
                document.getElementById('profilePic').innerHTML = `<img src="${currentUser.dp}" alt="DP">`;
            }
            if (!currentUser.contacts) currentUser.contacts = [];
            if (!currentUser.groups) currentUser.groups = [];
            if (!currentUser.messages) currentUser.messages = {};
            renderChatList();
            updateStatusTime();
            setInterval(updateStatusTime, 10000);
        }
    })();

    function saveUserData() {
        if (currentUser) {
            users[currentUser.email] = currentUser;
            localStorage.setItem('dream_users', JSON.stringify(users));
            localStorage.setItem('dream_last_user', currentUser.email);
        }
    }

    // ============================================================
    // CORE DATA
    // ============================================================
    let contacts = [];
    let groups = [];
    let messages = {};
    let currentChatId = null;
    let currentChatType = null;
    let currentChatName = null;

    // ============================================================
    // RENDER CHAT LIST
    // ============================================================
    function renderChatList() {
        if (!currentUser) return;
        contacts = currentUser.contacts || [];
        groups = currentUser.groups || [];
        messages = currentUser.messages || {};

        const container = document.getElementById('chatList');
        let chats = [];

        groups.forEach(g => {
            chats.push({
                id: g.id,
                type: 'group',
                name: g.name,
                lastMsg: g.lastMsg || 'No messages',
                time: g.time || '',
                unread: g.unread || 0,
                avatar: g.name[0].toUpperCase()
            });
        });

        contacts.forEach(c => {
            let lastMsg = messages[c.phone] ? messages[c.phone][messages[c.phone].length - 1] : null;
            chats.push({
                id: c.phone,
                type: 'contact',
                name: c.name,
                lastMsg: lastMsg ? lastMsg.text : 'Tap to chat',
                time: lastMsg ? lastMsg.time : c.lastSeen || '',
                unread: c.unread || 0,
                avatar: c.name[0].toUpperCase(),
                online: c.online || false
            });
        });

        chats.sort((a, b) => {
            const tA = a.time ? new Date('1970/01/01 ' + a.time) : 0;
            const tB = b.time ? new Date('1970/01/01 ' + b.time) : 0;
            return tB - tA;
        });

        if (chats.length === 0) {
            container.innerHTML = `
                <div class="empty-state-custom">
                    <div class="icon-big">💬</div>
                    <h3>No chats yet</h3>
                    <p>Add contacts or create a group</p>
                </div>
            `;
        } else {
            container.innerHTML = chats.map(chat => `
                <div class="chat-item" onclick="openChat('${chat.id}', '${chat.type}', '${chat.name}')">
                    <div class="avatar-container">
                        <div class="avatar">${chat.avatar}</div>
                        ${chat.online ? '<span class="online-dot"></span>' : ''}
                    </div>
                    <div class="chat-info">
                        <div class="name">${chat.name}</div>
                        <div class="message-preview">${chat.lastMsg}</div>
                    </div>
                    <div class="chat-meta">
                        <div class="time">${chat.time || ''}</div>
                        ${chat.unread > 0 ? `<div class="unread">${chat.unread}</div>` : ''}
                    </div>
                </div>
            `).join('');
        }

        const totalUnread = chats.reduce((sum, c) => sum + (c.unread || 0), 0);
        const badge = document.getElementById('chatBadge');
        if (totalUnread === 0) {
            badge.style.display = 'none';
        } else {
            badge.style.display = 'block';
            badge.textContent = totalUnread;
        }
    }

    // ============================================================
    // CHAT FUNCTIONS
    // ============================================================
    function openChat(id, type, name) {
        currentChatId = id;
        currentChatType = type;
        currentChatName = name;

        document.getElementById('mainScreen').style.display = 'none';
        document.getElementById('chatScreen').style.display = 'flex';

        document.getElementById('chatAvatarSmall').textContent = name[0].toUpperCase();
        document.getElementById('chatUserName').textContent = name;
        document.getElementById('chatUserStatus').textContent = type === 'group' ? '👥 Group' : '🟢 Online';

        if (!messages[id]) messages[id] = [];
        renderChatMessages(id);
        document.getElementById('chatInputCustom').focus();
    }

    function closeChat() {
        currentChatId = null;
        currentChatType = null;
        currentChatName = null;
        document.getElementById('chatScreen').style.display = 'none';
        document.getElementById('mainScreen').style.display = 'flex';
        saveUserData();
        renderChatList();
    }

    function renderChatMessages(id) {
        const container = document.getElementById('chatMessages');
        const msgs = messages[id] || [];

        if (msgs.length === 0) {
            container.innerHTML = `
                <div class="empty-state-custom">
                    <div class="icon-big">💬</div>
                    <h3>No messages</h3>
                    <p>Start the conversation</p>
                </div>
            `;
            return;
        }

        container.innerHTML = msgs.map(msg => `
            <div class="msg-custom ${msg.from === 'me' ? 'sent' : 'received'}">
                ${msg.from === 'other' ? `<div class="sender-name">${msg.fromName || currentChatName || 'User'}</div>` : ''}
                ${msg.text}
                ${msg.file ? `<div class="msg-file" onclick="downloadFile('${msg.file}')">
                    <span class="file-icon">📄</span>
                    <span class="file-name">${msg.fileName || 'file'}</span>
                </div>` : ''}
                <div class="time">${msg.time}</div>
            </div>
        `).join('');

        container.scrollTop = container.scrollHeight;
    }

    function sendMessageCustom() {
        const input = document.getElementById('chatInputCustom');
        const text = input.value.trim();
        if (!text || !currentChatId) return;

        if (!messages[currentChatId]) messages[currentChatId] = [];

        messages[currentChatId].push({
            from: 'me',
            text: text,
            time: getCurrentTime()
        });

        // Update preview
        const contact = contacts.find(c => c.phone === currentChatId);
        if (contact) {
            contact.lastMsg = text;
            contact.time = getCurrentTime();
        } else {
            const group = groups.find(g => g.id === currentChatId);
            if (group) {
                group.lastMsg = text;
                group.time = getCurrentTime();
            }
        }

        renderChatMessages(currentChatId);
        input.value = '';
        input.focus();
        saveUserData();
    }

    // ============================================================
    // FILE ATTACHMENT
    // ============================================================
    function attachFile() {
        const input = document.createElement('input');
        input.type = 'file';
        input.accept = '.pdf,.jpg,.jpeg,.png,.gif,.mp4,.mov,.doc,.docx';
        input.onchange = function(e) {
            const file = e.target.files[0];
            if (!file || !currentChatId) return;
            const reader = new FileReader();
            reader.onload = function(ev) {
                const dataUrl = ev.target.result;
                if (!messages[currentChatId]) messages[currentChatId] = [];
                messages[currentChatId].push({
                    from: 'me',
                    text: `📎 ${file.name}`,
                    file: dataUrl,
                    fileName: file.name,
                    time: getCurrentTime()
                });
                renderChatMessages(currentChatId);
                saveUserData();
                showToast(`✅ ${file.name} attached`);
            };
            reader.readAsDataURL(file);
        };
        input.click();
    }

    function downloadFile(dataUrl) {
        const link = document.createElement('a');
        link.href = dataUrl;
        link.download = 'downloaded_file';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        showToast('⬇️ Downloading...');
    }

    // ============================================================
    // VIDEO CALL
    // ============================================================
    let isMuted = false;

    function startVideoCall() {
        document.getElementById('videoCallOverlay').classList.add('active');
        showToast('📹 Video call started');
        // Simulate remote video
        document.getElementById('videoRemote').innerHTML = '📹 <span style="font-size:20px;display:block;margin-top:10px;">Remote User</span>';
    }

    function endVideoCall() {
        document.getElementById('videoCallOverlay').classList.remove('active');
        showToast('📞 Call ended');
    }

    function toggleMute() {
        isMuted = !isMuted;
        document.querySelector('.mute-call').textContent = isMuted ? '🔇' : '🎤';
        showToast(isMuted ? '🔇 Muted' : '🎤 Unmuted');
    }

    // ============================================================
    // GROUPS
    // ============================================================
    function openGroups() {
        document.getElementById('mainScreen').style.display = 'none';
        document.getElementById('groupsPanel').classList.add('active');
        renderGroups();
    }

    function closeGroups() {
        document.getElementById('groupsPanel').classList.remove('active');
        document.getElementById('mainScreen').style.display = 'flex';
    }

    function renderGroups() {
        const container = document.getElementById('groupList');
        groups = currentUser.groups || [];
        if (groups.length === 0) {
            container.innerHTML = `
                <div class="empty-state-custom">
                    <div class="icon-big">👥</div>
                    <h3>No groups</h3>
                    <p>Create your first group</p>
                </div>
            `;
            return;
        }

        container.innerHTML = groups.map(g => `
            <div class="chat-item" onclick="openChat('${g.id}', 'group', '${g.name}')">
                <div class="avatar-container"><div class="avatar">${g.name[0].toUpperCase()}</div></div>
                <div class="chat-info">
                    <div class="name">${g.name}</div>
                    <div class="message-preview">${g.lastMsg || 'No messages'}</div>
                </div>
                <div class="chat-meta">
                    <div class="time">${g.time || ''}</div>
                    ${g.unread > 0 ? `<div class="unread">${g.unread}</div>` : ''}
                </div>
            </div>
        `).join('');
    }

    function showCreateGroupModal() {
        document.getElementById('createGroupModal').classList.add('active');
        document.getElementById('groupNameInput').value = '';
        document.getElementById('groupMembersInput').value = '';
    }

    function createGroup() {
        const name = document.getElementById('groupNameInput').value.trim();
        const members = document.getElementById('groupMembersInput').value.trim();

        if (!name) {
            showToast('❌ Group name required');
            return;
        }

        const memberList = members ? members.split(',').map(m => m.trim()).filter(m => m) : [];
        const allMembers = [currentUser.phone, ...memberList];

        if (!currentUser.groups) currentUser.groups = [];
        currentUser.groups.push({
            id: 'g' + Date.now(),
            name: name,
            members: allMembers,
            lastMsg: 'Group created',
            time: getCurrentTime(),
            unread: 0
        });

        closeModal('createGroupModal');
        saveUserData();
        renderGroups();
        renderChatList();
        showToast(`✅ Group "${name}" created`);
    }

    // ============================================================
    // SETTINGS
    // ============================================================
    function openSettings() {
        document.getElementById('mainScreen').style.display = 'none';
        document.getElementById('settingsPanel').classList.add('active');
        document.getElementById('settingsUserName').textContent = currentUser.name;
        document.getElementById('settingsUserPhone').textContent = `📱 +91 ${currentUser.phone}`;
        document.getElementById('profilePic').textContent = currentUser.name[0].toUpperCase();
        if (currentUser.dp) {
            document.getElementById('profilePic').innerHTML = `<img src="${currentUser.dp}" alt="DP">`;
        }
    }

    function closeSettings() {
        document.getElementById('settingsPanel').classList.remove('active');
        document.getElementById('mainScreen').style.display = 'flex';
        saveUserData();
        renderChatList();
    }

    function changeProfilePic() {
        const url = prompt('Enter image URL:', currentUser.dp || '');
        if (url !== null) {
            currentUser.dp = url.trim() || '';
            if (currentUser.dp) {
                document.getElementById('profilePic').innerHTML = `<img src="${currentUser.dp}" alt="DP">`;
            } else {
                document.getElementById('profilePic').textContent = currentUser.name[0].toUpperCase();
            }
            saveUserData();
            showToast('✅ Profile picture updated');
        }
    }

    function editProfile() {
        const newName = prompt('Enter your name:', currentUser.name);
        if (newName !== null && newName.trim()) {
            currentUser.name = newName.trim();
            document.getElementById('settingsUserName').textContent = currentUser.name;
            document.getElementById('profilePic').textContent = currentUser.name[0].toUpperCase();
            saveUserData();
            showToast('✅ Name updated');
        }
    }

    function toggleSwitch(el) {
        el.classList.toggle('active');
        const status = el.classList.contains('active') ? 'ON' : 'OFF';
        const label = el.closest('.settings-item').querySelector('.s-info h4').textContent;
        showToast(`${label}: ${status}`);
    }

    // ============================================================
    // BACKUP & DOWNLOAD
    // ============================================================
    function backupData() {
        if (!currentUser) return;
        saveUserData();
        // Also backup to Gmail (simulated - store in localStorage with email)
        const backupKey = `dream_backup_${currentUser.email}`;
        localStorage.setItem(backupKey, JSON.stringify({
            user: currentUser,
            timestamp: new Date().toISOString()
        }));
        showToast('☁️ Backup saved to cloud (local)');
    }

    function downloadData() {
        if (!currentUser) return;
        const data = JSON.stringify(currentUser, null, 2);
        const blob = new Blob([data], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = url;
        link.download = `dream_backup_${currentUser.email}.json`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(url);
        showToast('⬇️ Backup downloaded');
    }

    // ============================================================
    // UTILITY
    // ============================================================
    function getCurrentTime() {
        const now = new Date();
        let h = now.getHours();
        const ampm = h >= 12 ? 'PM' : 'AM';
        h = h % 12 || 12;
        const m = String(now.getMinutes()).padStart(2, '0');
        return `${h}:${m} ${ampm}`;
    }

    function updateStatusTime() {
        document.getElementById('statusTime').textContent = getCurrentTime();
    }

    function showToast(msg) {
        const t = document.getElementById('toastCustom');
        t.textContent = msg;
        t.classList.remove('hidden');
        clearTimeout(t._timeout);
        t._timeout = setTimeout(() => t.classList.add('hidden'), 2500);
    }

    function closeModal(id) {
        document.getElementById(id).classList.remove('active');
    }

    function filterChats() {
        const q = document.getElementById('searchInput').value.toLowerCase();
        document.querySelectorAll('.chat-item').forEach(el => {
            const name = el.querySelector('.name')?.textContent?.toLowerCase() || '';
            const preview = el.querySelector('.message-preview')?.textContent?.toLowerCase() || '';
            el.style.display = (name.includes(q) || preview.includes(q)) ? 'flex' : 'none';
        });
    }

    function switchTab(tab) {
        document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
        const clicked = document.querySelector(`.nav-item[onclick*="${tab}"]`);
        if (clicked) clicked.classList.add('active');

        if (tab === 'chats') renderChatList();
        else if (tab === 'calls') showToast('📞 Call history');
        else if (tab === 'updates') showToast('📢 Status updates');
        else if (tab === 'tools') showToast('🛠️ Tools');
    }

    // ============================================================
    // ADD CONTACT (from console)
    // ============================================================
    window.addContact = function(name, phone) {
        if (!currentUser) return showToast('❌ Please login first');
        if (!name || !phone) return showToast('❌ Name & phone required');
        if (!currentUser.contacts) currentUser.contacts = [];
        if (currentUser.contacts.find(c => c.phone === phone)) return showToast('⚠️ Contact already exists');
        currentUser.contacts.push({ phone, name, online: true, lastSeen: getCurrentTime(), unread: 0 });
        saveUserData();
        renderChatList();
        showToast(`✅ ${name} added`);
    };

    // ============================================================
    // KEYBOARD SHORTCUTS
    // ============================================================
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            if (document.getElementById('chatScreen').style.display === 'flex') closeChat();
            if (document.getElementById('settingsPanel').classList.contains('active')) closeSettings();
            if (document.getElementById('groupsPanel').classList.contains('active')) closeGroups();
            if (document.getElementById('videoCallOverlay').classList.contains('active')) endVideoCall();
            closeModal('createGroupModal');
        }
    });

    // ============================================================
    // INIT
    // ============================================================
    console.log('🌟 Dream Josh · Full Suite');
    console.log('📌 Commands: addContact("Name", "phone")');
    console.log('☁️ Backup auto-saved to localStorage with Gmail ID');
</script>
</body>
</html>
